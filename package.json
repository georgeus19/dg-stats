{
  "name": "dg-stats",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.14.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dg-stats/web dev",
    "build": "pnpm --filter @dg-stats/web build",
    "typecheck": "pnpm --filter @dg-stats/web typecheck && pnpm --filter @dg-stats/domain typecheck && pnpm --filter @dg-stats/database typecheck && pnpm --filter @dg-stats/sync typecheck && pnpm typecheck:infra",
    "typecheck:infra": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck neon.ts",
    "test": "pnpm --filter @dg-stats/domain test",
    "validate": "pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @dg-stats/database generate",
    "db:migrate": "pnpm --filter @dg-stats/database migrate",
    "neon:deploy": "neon deploy"
  },
  "devDependencies": {
    "@neondatabase/config": "latest",
    "typescript": "^5.8.3"
  }
}
